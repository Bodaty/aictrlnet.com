{% for file in site.static_files %}{% if file.extname == ".html" and file.path != "/index.html" and file.path != "/404.html" %}  <url><loc>https://aictrlnet.com{{ file.path | replace: "index.html", "" }}</loc></url>
{% endif %}{% endfor %}{% for page in site.pages %}{% unless page.url == "/sitemap.xml" or page.url == "/feed.xml" or page.url == "/404.html" or page.url contains ".css" or page.url contains ".js" or page.url contains ".json" or page.url contains ".txt" %}  <url><loc>https://aictrlnet.com{{ page.url }}</loc></url>
{% endunless %}{% endfor %}{% for post in site.posts %}  <url><loc>https://aictrlnet.com{{ post.url }}</loc><lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod></url>
{% endfor %}</urlset>
